{
  "name": "valuebet-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend de ValueBet Engine — enfocado en arbitraje",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "types:generate": "openapi-typescript http://127.0.0.1:8000/openapi.json -o lib/api-types.ts",
    "types:check": "openapi-typescript http://127.0.0.1:8000/openapi.json -o lib/api-types.ts && git diff --exit-code lib/api-types.ts"
  },
  "dependencies": {
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
